generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model OrderBrief {
  id              String   @id @default(cuid())
  ref             String   @unique
  brandName       String
  industry        String?
  businessDesc    String?
  audience        String?
  competitors     String?
  differentiation String?
  personality     String? // JSON array
  visualStyle     String?
  colorsLove      String? // JSON array
  colorsAvoid     String?
  usageAreas      String? // JSON array
  concepts        String?
  timeline        String?
  budget          String?
  contactName     String
  contactMethod   String
  links           String?
  createdAt       DateTime @default(now())
}