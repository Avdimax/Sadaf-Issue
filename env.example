# ── local dev / standalone host (bun dev, bun start) ──────────────
DATABASE_URL=file:./db/custom.db

# ── order delivery — used by /api/order and the Cloudflare Worker ──
# Resend (resend.com) — the email channel. Without it, orders only land
# in the local SQLite drawer.
RESEND_API_KEY=
RESEND_FROM="Atelier Orders <orders@yourdomain.com>"
OWNER_EMAIL=hello@sadaf.design

# Telegram — the instant, free channel (works from Iran, no signup friction).
# BotFather → /newbot → token; get chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── static deploy (GitHub Pages) ───────────────────────────────────
# Where the OrderTheater posts the brief when the site is exported:
#   Worker:    https://sadaf-order.<account>.workers.dev
#   Formspree: https://formspree.io/f/<id>
#   PHP:       https://<host>/order/order.php
# Empty → falls back to /api/order (local dev / full Next host).
NEXT_PUBLIC_ORDER_ENDPOINT=

# Project-site sub-path, e.g. /sadaf-portfolio — leave empty for
# user sites (user.github.io) or custom domains. Set automatically
# by .github/workflows/deploy.yml.
NEXT_PUBLIC_BASE_PATH=
